{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "ignoreDeprecations": "5.0",
    "skipLibCheck": true,
    "lib": [
      "ES2020"
    ],
    "types": [
      "react",
      "react-native"
    ]
  },
  "include": [
    "src"
  ],
  "extends": "expo/tsconfig.base"
}
