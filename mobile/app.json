{
  "expo": {
    "name": "Poduna",
    "slug": "shopping-list-app",
    "scheme": "smartshopping",
    "version": "0.1.14",
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F3"
    },
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Poduna à scanner des produits, des invitations et des listes écrites.",
          "microphonePermission": false,
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store",
      "./plugins/withLocalSpeech.cjs"
    ],
    "android": {
      "versionCode": 15,
      "package": "com.smartshopping.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#245C46"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.smartshopping.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Autoriser Poduna à scanner des produits, des invitations et des listes écrites."
      }
    }
  }
}
