{
  "expo": {
    "name": "SmartShopping",
    "slug": "shopping-list-app",
    "scheme": "smartshopping",
    "version": "0.1.8",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser SmartShopping à scanner des produits, des invitations et des listes écrites.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "versionCode": 9,
      "package": "com.smartshopping.app",
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.smartshopping.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Autoriser SmartShopping à scanner des produits, des invitations et des listes écrites."
      }
    }
  }
}
