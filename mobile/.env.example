# Local development: replace with the computer's LAN address if necessary.
# No value is enabled by default, so Expo Go keeps automatic host discovery.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000/api/v1

# Standalone builds require a real HTTPS API ending in /api/v1.
# Configure EXPO_PUBLIC_API_BASE_URL in EAS preview / production environments.
# EAS_PROJECT_ID is the UUID supplied by Expo after project creation.
# These values are public. Never put payment or signing secrets here.
