{
  "name": "shopping-list-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/db/schema.integration.test.ts",
    "test:components": "jest --runInBand",
    "e2e:android": "maestro test e2e/android",
    "build:dev:android": "pnpm dlx eas-cli@16.17.4 build --profile development --platform android",
    "build:dev:ios": "pnpm dlx eas-cli@16.17.4 build --profile development --platform ios"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "expo": "~54.0.35",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-network": "~8.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-svg": "15.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.17",
    "@types/sql.js": "^1.4.11",
    "expo-doctor": "1.17.11",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "sql.js": "^1.14.1",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  }
}
