{
  "name": "shopping-list-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:build-config": "node --test config/build-config.test.cjs",
    "test:integration": "vitest run .integration.test.ts",
    "test:components": "jest --runInBand",
    "e2e:android": "maestro test e2e/android",
    "build:dev:android": "pnpm dlx eas-cli@16.17.4 build --profile development --platform android",
    "build:dev:ios": "pnpm dlx eas-cli@16.17.4 build --profile development --platform ios",
    "build:preview:android": "pnpm dlx eas-cli@16.17.4 build --profile preview --platform android",
    "build:direct:android": "pnpm dlx eas-cli@16.17.4 build --profile direct --platform android",
    "build:store:android": "pnpm dlx eas-cli@16.17.4 build --profile production --platform android",
    "build:store:ios": "pnpm dlx eas-cli@16.17.4 build --profile production --platform ios",
    "preview:ui": "node preview/serve.mjs",
    "build:preview:local": "bash ../ops/build-preview-apk.sh"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@noble/hashes": "1.8.0",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-network": "~8.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.17",
    "@types/sql.js": "^1.4.11",
    "esbuild": "0.25.12",
    "expo-doctor": "1.17.11",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "react-dom": "19.1.0",
    "react-native-web": "~0.21.3",
    "react-test-renderer": "19.1.0",
    "sql.js": "^1.14.1",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  }
}
