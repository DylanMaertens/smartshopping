{
  "name": "shopping-list-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "prebuild": "expo prebuild --no-clean",
    "prebuild:clean": "expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:build-config": "node --test config/*.test.cjs",
    "test:integration": "vitest run .integration.test.ts",
    "test:components": "jest --runInBand",
    "e2e:android": "maestro test e2e/android",
    "build:dev:android": "pnpm dlx eas-cli@16.17.4 build --profile development --platform android",
    "build:dev:ios": "pnpm dlx eas-cli@16.17.4 build --profile development --platform ios",
    "build:preview:android": "pnpm dlx eas-cli@16.17.4 build --profile preview --platform android",
    "build:direct:android": "pnpm dlx eas-cli@16.17.4 build --profile direct --platform android",
    "build:store:android": "pnpm dlx eas-cli@16.17.4 build --profile production --platform android",
    "build:store:ios": "pnpm dlx eas-cli@16.17.4 build --profile production --platform ios",
    "preview:ui": "node preview/serve.mjs",
    "build:preview:local": "bash ../ops/build-preview-apk.sh"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@noble/hashes": "1.8.0",
    "expo": "~58.0.16",
    "expo-camera": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-image-manipulator": "~58.0.16",
    "expo-network": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-qrcode-svg": "6.3.26",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "zod": "^3.23.8"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-camera"]
      }
    }
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.3",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "babel-preset-expo": "~58.0.18",
    "esbuild": "0.25.12",
    "expo-doctor": "1.21.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "react-dom": "19.3.0",
    "react-native-web": "~0.21.4",
    "react-test-renderer": "19.3.0",
    "sql.js": "^1.14.1",
    "typescript": "~6.0.3",
    "vitest": "4.1.12"
  }
}
