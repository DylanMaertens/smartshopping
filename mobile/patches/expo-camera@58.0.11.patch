@@ -0,0 +1,31 @@
+package expo.modules.camera
+
+import androidx.camera.core.CameraState
+import androidx.lifecycle.LifecycleOwner
+import androidx.lifecycle.LiveData
+import androidx.lifecycle.Observer
+
+// Own the subscription at view lifetime, not at Activity lifetime. A discarded
+// camera view must never replay its torch preference when a new view opens.
+internal class CameraStateSubscription {
+  private var stopObserving: (() -> Unit)? = null
+
+  fun observe(state: LiveData<CameraState>, owner: LifecycleOwner, onOpen: () -> Unit) {
+    clear()
+    var active = true
+    val observer = Observer<CameraState> {
+      if (active && it.type == CameraState.Type.OPEN) onOpen()
+    }
+    stopObserving = {
+      active = false
+      state.removeObserver(observer)
+    }
+    state.observe(owner, observer)
+  }
+
+  fun clear() {
+    val stop = stopObserving
+    stopObserving = null
+    stop?.invoke()
+  }
+}
