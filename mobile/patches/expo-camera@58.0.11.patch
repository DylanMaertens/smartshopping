@@ -0,0 +1,77 @@
+package expo.modules.camera
+
+import androidx.camera.core.CameraState
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.LifecycleOwner
+import androidx.lifecycle.LifecycleRegistry
+import androidx.lifecycle.MutableLiveData
+import androidx.lifecycle.Observer
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, sdk = [28])
+class CameraStateSubscriptionTest {
+  private class Owner : LifecycleOwner {
+    override val lifecycle = LifecycleRegistry(this).apply {
+      currentState = Lifecycle.State.RESUMED
+    }
+  }
+
+  @Test
+  fun discardedCameraCannotReplayItsTorchPreference() {
+    val state = MutableLiveData(CameraState.create(CameraState.Type.CLOSED))
+    val owner = Owner()
+    var torch = false
+    val oldCamera = CameraStateSubscription()
+    oldCamera.observe(state, owner) { torch = true }
+    state.value = CameraState.create(CameraState.Type.OPEN)
+    assertTrue(torch)
+    oldCamera.clear()
+    oldCamera.clear() // cleanup is safe more than once
+    torch = false
+    assertFalse(state.hasObservers())
+    state.value = CameraState.create(CameraState.Type.CLOSED)
+    val newCamera = CameraStateSubscription()
+    var newCameraReady = 0
+    newCamera.observe(state, owner) { newCameraReady++ }
+    state.value = CameraState.create(CameraState.Type.OPEN)
+    assertFalse(torch)
+    assertEquals(1, newCameraReady)
+    newCamera.clear()
+  }
+
+  @Test
+  fun rebindingReplacesThePreviousSubscription() {
+    val state = MutableLiveData(CameraState.create(CameraState.Type.CLOSED))
+    val owner = Owner()
+    val subscription = CameraStateSubscription()
+    var oldCalls = 0
+    var newCalls = 0
+    subscription.observe(state, owner) { oldCalls++ }
+    subscription.observe(state, owner) { newCalls++ }
+    state.value = CameraState.create(CameraState.Type.OPEN)
+    assertEquals(0, oldCalls)
+    assertEquals(1, newCalls)
+    subscription.clear()
+    assertFalse(state.hasObservers())
+  }
+
+  @Test
+  fun clearingOneViewPreservesOtherObserversOnTheActivity() {
+    val state = MutableLiveData(CameraState.create(CameraState.Type.CLOSED))
+    val owner = Owner()
+    var otherCalls = 0
+    val other = Observer<CameraState> { if (it.type == CameraState.Type.OPEN) otherCalls++ }
+    state.observe(owner, other)
+    val subscription = CameraStateSubscription()
+    subscription.observe(state, owner) { fail("Discarded observer invoked") }
+    subscription.clear()
+    state.value = CameraState.create(CameraState.Type.OPEN)
+    assertEquals(1, otherCalls)
+    state.removeObserver(other)
+  }
+}
