+package expo.modules.camera
+
+/** Invalidates asynchronous camera starts as soon as their view leaves the window. */
+internal class CameraSession {
+  private var generation = 0L
+  private var active = false
+  private var destroyed = false
+
+  fun resume() {
+    if (!destroyed) active = true
+  }
+
+  fun stop() {
+    active = false
+    generation++
+  }
+
+  fun destroy() {
+    stop()
+    destroyed = true
+  }
+
+  fun begin(): Long? = if (active) ++generation else null
+
+  fun isCurrent(request: Long) = active && request == generation
+}
