@@ -0,0 +1,53 @@
+package expo.modules.camera
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class CameraSessionTest {
+  @Test
+  fun cannotStartBeforeAttachmentOrAfterExit() {
+    val session = CameraSession()
+    assertNull(session.begin())
+    session.resume()
+    val request = session.begin()!!
+    assertTrue(session.isCurrent(request))
+    session.stop()
+    assertFalse(session.isCurrent(request))
+    assertNull(session.begin())
+  }
+
+  @Test
+  fun reopeningDoesNotReviveAPendingOldStart() {
+    val session = CameraSession()
+    session.resume()
+    val old = session.begin()!!
+    session.stop()
+    session.resume()
+    assertFalse(session.isCurrent(old))
+    val fresh = session.begin()!!
+    assertFalse(session.isCurrent(old))
+    assertTrue(session.isCurrent(fresh))
+  }
+
+  @Test
+  fun newestConfigurationWins() {
+    val session = CameraSession()
+    session.resume()
+    val old = session.begin()!!
+    val fresh = session.begin()!!
+    assertFalse(session.isCurrent(old))
+    assertTrue(session.isCurrent(fresh))
+  }
+
+  @Test
+  fun destructionIsFinalAndIdempotent() {
+    val session = CameraSession()
+    session.resume()
+    val request = session.begin()!!
+    session.destroy()
+    session.destroy()
+    session.resume()
+    assertFalse(session.isCurrent(request))
+    assertNull(session.begin())
+  }
+}
