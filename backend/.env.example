HOST=0.0.0.0
PORT=3000
RUST_LOG=info
CACHE_TTL_SECONDS=604800
PRODUCT_CACHE_CAPACITY=10000
# Lookup order after cache: Food, Products, Beauty, Pet Food.
OFF_BASE_URL=https://world.openfoodfacts.org/api/v2
OPF_BASE_URL=https://world.openproductsfacts.org/api/v2
OBF_BASE_URL=https://world.openbeautyfacts.org/api/v2
OPFF_BASE_URL=https://world.openpetfoodfacts.org/api/v2
OFF_RATE_LIMIT_PER_MINUTE=100
OFF_MAX_RETRIES=2
ALLOWED_ORIGIN=http://localhost:8081
ENABLE_SYNC_ENDPOINT=false
# Enables the four catalogue lookups.
ENABLE_OFF_PROXY=true
DEVICE_REGISTRY_PATH=./data/device_registry.json
REDIS_URL=
DATABASE_URL=
METRICS_TOKEN=
API_RATE_LIMIT_PER_MINUTE=120
REQUIRE_DEVICE_SIGNATURES=true
# Catalogue communautaire : lecture après les quatre API externes. Nécessite PostgreSQL.
ENABLE_COMMUNITY_CATALOG=false
# Paramètres de départ configurables, à confirmer après essais ; ils ne constituent pas une règle produit définitive.
COMMUNITY_CONSENSUS_MIN_DEVICES=5
COMMUNITY_CONSENSUS_RATIO=0.8
# Expressions publiques séparées par des virgules. Aucun effet sur les noms privés enregistrés dans l'app.
COMMUNITY_PROHIBITED_TERMS=
COMMUNITY_PROHIBITED_EXCEPTIONS=
# Base64 de 32 octets. En production, utiliser DEVICE_SECRET_KEY_FILE monté par le gestionnaire de secrets.
DEVICE_SECRET_KEY=
# Ancienne clé pendant une rotation progressive ; la lecture ré-encrypte avec la clé courante.
DEVICE_SECRET_PREVIOUS_KEY=
# Alternative managée prioritaire : Vault Transit. Le token doit venir d'un fichier secret.
VAULT_ADDR=
VAULT_TOKEN_FILE=
VAULT_TRANSIT_KEY=smartshopping-device-secrets
