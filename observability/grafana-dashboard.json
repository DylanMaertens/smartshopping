{
  "title": "SmartShopping API",
  "uid": "smartshopping-api",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    { "type": "timeseries", "title": "Requêtes par endpoint", "targets": [{ "expr": "sum by (endpoint) (rate(smartshopping_http_request_duration_seconds_count[5m]))" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 } },
    { "type": "timeseries", "title": "Latence p95", "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(smartshopping_http_request_duration_seconds_bucket[5m])))" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 } },
    { "type": "stat", "title": "Ratio cache produit", "targets": [{ "expr": "smartshopping_product_cache_hit_ratio" }], "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 } },
    { "type": "timeseries", "title": "OFF succès / erreurs", "targets": [{ "expr": "rate(smartshopping_off_lookup_successes_total[5m])" }, { "expr": "rate(smartshopping_off_lookup_failures_total[5m])" }], "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 } },
    { "type": "timeseries", "title": "Synchronisations", "targets": [{ "expr": "rate(smartshopping_sync_attempts_total[5m])" }, { "expr": "rate(smartshopping_sync_successes_total[5m])" }], "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 } }
  ]
}
